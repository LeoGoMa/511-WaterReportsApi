meta {
  name: 01 - Registrar Usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Cuadrilla Norte",
    "email": "{{email}}",
    "password": "{{password}}",
    "isNotificationEnabled": true
  }
}

assert {
  res.status: eq 201
  res.body.email: eq {{email}}
}
